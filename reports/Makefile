# reports/Makefile — one command rebuilds every number, then the PDF.
#
#   make paper     regenerate figures from ../results, verify bib, then latexmk
#   make figures   regenerate figures/*.pdf from ../results/*.json
#   make verifybib resolve every refs.bib entry against arXiv/ACL (fails on mismatch)
#   make draft     compile paper.tex WITHOUT regenerating figures (placeholders allowed)
#   make clean     remove build artifacts (keeps figures/ and the PDF)
#
# `make paper` is the real gate: it fails loudly if a figure's result files are missing,
# so a shipped PDF can never contain a placeholder or a hand-entered number.

PYTHON  ?= python3
SCRIPTS := ../scripts
RESULTS := ../results
FIGDIR  := figures

# fig3_decomposition and fig5_latency are NOT in the required build: no results/*.json cell carries
# byte_decomposition or decode_tokens_per_s (see paper.tex Limitations), and paper.tex does not
# \datafig them. Their scripts still exist under scripts/ for whoever adds that instrumentation.
FIGURE_SCRIPTS := fig1_mispricing fig2_reranking
FIGURE_PDFS    := $(addprefix $(FIGDIR)/,$(addsuffix .pdf,$(FIGURE_SCRIPTS)))
TABLES         := $(FIGDIR)/table1_rank.tex

.PHONY: paper figures verifybib draft clean

paper: verifybib figures $(TABLES)
	latexmk -pdf -interaction=nonstopmode -halt-on-error paper.tex

# Each figure PDF is regenerated by its script; the script must read only from $(RESULTS)
# and must exit non-zero (not emit a placeholder) if its result cells are missing.
$(FIGDIR)/%.pdf: $(SCRIPTS)/%.py $(wildcard $(RESULTS)/*.json) | $(FIGDIR)
	$(PYTHON) $< --results $(RESULTS) --out $@

$(FIGDIR)/table1_rank.tex: $(SCRIPTS)/table1_rank.py $(wildcard $(RESULTS)/*.json) | $(FIGDIR)
	$(PYTHON) $< --results $(RESULTS) --out $@

figures: $(FIGURE_PDFS)

$(FIGDIR):
	mkdir -p $(FIGDIR)

verifybib:
	$(PYTHON) $(SCRIPTS)/verify_bib.py refs.bib

draft:
	latexmk -pdf -interaction=nonstopmode paper.tex

clean:
	latexmk -c paper.tex
	rm -f paper.bbl
